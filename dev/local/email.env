# email from the IDE, the rest of the identity stack in Docker (see security.env for the idea).
QUARKUS_PROFILE=prod
# the container listens on 8080 behind the 8082 mapping; on the host 8080 belongs to security
QUARKUS_HTTP_PORT=8082
MAIL_API_KEY=local-dev-key
QUARKUS_MAILER_HOST=localhost
QUARKUS_MAILER_PORT=1025
QUARKUS_MAILER_MOCK=false
MAIL_SMTP_START_TLS=DISABLED
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

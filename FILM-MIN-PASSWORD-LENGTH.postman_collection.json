{
  "info": {
    "name": "Film 5 - live minimum password length",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "admin",
      "value": "admin@example.com"
    },
    {
      "key": "adminPassword",
      "value": "StrongPassword1!"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "verifyToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Register admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/register",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{admin}}\",\"password\":\"{{adminPassword}}\"}"
        }
      }
    },
    {
      "name": "0. Verify email (token from Mailpit :8025)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/verify-email",
        "body": {
          "mode": "raw",
          "raw": "{\"token\":\"{{verifyToken}}\"}"
        }
      }
    },
    {
      "name": "0. Authenticate (stores token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('token', pm.response.json().accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/authenticate",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{admin}}\",\"password\":\"{{adminPassword}}\"}"
        }
      }
    },
    {
      "name": "1. GET min-length (ladder report)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/admin/settings/password/min-length"
      }
    },
    {
      "name": "2. Step-up admin-settings",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/account/step-up",
        "body": {
          "mode": "raw",
          "raw": "{\"action\":\"admin-settings\",\"password\":\"{{adminPassword}}\"}"
        }
      }
    },
    {
      "name": "3. POST min-length = 10 [auto step-up]",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/admin/settings/password/min-length",
        "body": {
          "mode": "raw",
          "raw": "{\"value\":10}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// elevation is consumed by ONE admin write - buy a fresh one right before this request",
              "pm.sendRequest({",
              "  url: pm.collectionVariables.get('baseUrl') + '/account/step-up',",
              "  method: 'POST',",
              "  header: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + pm.collectionVariables.get('token') },",
              "  body: { mode: 'raw', raw: JSON.stringify({ action: 'admin-settings', password: pm.collectionVariables.get('adminPassword') }) }",
              "}, (err, res) => { if (err || res.code !== 200) console.warn('step-up failed', err || res.json()); });"
            ]
          }
        }
      ]
    },
    {
      "name": "4. POST min-length = 3 (refused) [auto step-up]",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/admin/settings/password/min-length",
        "body": {
          "mode": "raw",
          "raw": "{\"value\":3}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// elevation is consumed by ONE admin write - buy a fresh one right before this request",
              "pm.sendRequest({",
              "  url: pm.collectionVariables.get('baseUrl') + '/account/step-up',",
              "  method: 'POST',",
              "  header: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + pm.collectionVariables.get('token') },",
              "  body: { mode: 'raw', raw: JSON.stringify({ action: 'admin-settings', password: pm.collectionVariables.get('adminPassword') }) }",
              "}, (err, res) => { if (err || res.code !== 200) console.warn('step-up failed', err || res.json()); });"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Register user - 9 chars (422 when min is 10)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/register",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"newcomer@example.com\",\"password\":\"Nine1!aaa\"}"
        }
      }
    },
    {
      "name": "6. Register user - 5 chars (passes when min is 5)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/register",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"short@example.com\",\"password\":\"Ab1!x\"}"
        }
      }
    }
  ]
}
